# Maintainer: gknowledge contributors
pkgname=gknowledge
pkgver=0.1.0
pkgrel=1
pkgdesc="Native GNOME knowledge workstation that builds an LLM-maintained wiki"
arch=('any')
url="https://github.com/openapi/gknowledge"
license=('MIT')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita')
optdepends=('python-pypdf: PDF sources')
makedepends=('make')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr PYTHON=/usr/bin/python3
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

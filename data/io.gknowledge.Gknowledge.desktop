[Desktop Entry]
Type=Application
Name=gknowledge
GenericName=Knowledge Workstation
Comment=Turn documents and notes into an evolving knowledge base
Exec=gknowledge %U
Icon=io.gknowledge.Gknowledge
Terminal=false
Categories=GNOME;GTK;Office;
Keywords=knowledge;wiki;notes;llm;research;rag;
StartupNotify=true
MimeType=text/markdown;text/plain;application/pdf;text/html;
StartupWMClass=io.gknowledge.Gknowledge
SingleMainWindow=true
